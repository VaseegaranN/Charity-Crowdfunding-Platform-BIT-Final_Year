@{
    ViewData["Title"] = "Logistics Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Logistics Login - UnityFunds</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/unityfunds-refresh.css" />
</head>
<body class="uf-auth-page uf-role--logistics">
    <main class="uf-auth uf-auth--center">
        <aside class="uf-auth__brand">
            <a class="uf-auth__brand-top" href="/"><span class="uf-auth__mark">U</span> UnityFunds</a>
            <div class="uf-auth__brand-body">
                <span class="uf-auth__eyebrow">Logistics Portal</span>
                <h1>Move resources where they matter most.</h1>
                <p>Coordinate deliveries, manage dispatch and keep every donation moving smoothly.</p>
                <ul class="uf-auth__points">
                    <li>Manage delivery requests</li>
                    <li>Coordinate with NGOs</li>
                    <li>Track shipments end to end</li>
                </ul>
            </div>
            <div class="uf-auth__brand-foot">(c) UnityFunds</div>
        </aside>
        <section class="uf-auth__main">
            <div class="uf-auth__card">
                <div class="uf-auth__role-chip"><span class="uf-auth__role-dot"></span> Logistics workspace</div>
                <div class="uf-auth__head">
                    <h2>Logistics sign in</h2>
                    <p>Access your logistics dashboard.</p>
                </div>
                @if (ViewBag.Error != null)
                {
                    <div class="uf-alert uf-alert--error">@ViewBag.Error</div>
                }
                <form method="post" asp-action="Login">
                    <div class="uf-field">
                        <label for="email">Email or username</label>
                        <input id="email" type="text" name="email" placeholder="you@example.com" autocomplete="username" required>
                    </div>
                    <div class="uf-field">
                        <label for="password">Password</label>
                        <input id="password" type="password" name="password" placeholder="Enter your password" autocomplete="current-password" required>
                    </div>
                    <button type="submit" class="uf-btn">Sign in</button>
                </form>
                <p class="uf-auth__alt">New logistics partner? <a href="/Logistics/Signup">Register here</a></p>
            </div>
        </section>
    </main>
</body>
</html>
