@using Microsoft.AspNetCore.Http
@{
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Landing";
    var adminName = Context.Session.GetString("AdminName") ?? "Administrator";
    string Active(string name) => string.Equals(action, name, StringComparison.OrdinalIgnoreCase) ? "is-active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#153d2c" />
    <title>@ViewData["Title"] - UnityFunds Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
</head>
<body class="uf-admin">
    <div class="admin-shell">
        <aside class="admin-sidebar" id="adminSidebar">
            <a class="admin-brand" asp-controller="Admin" asp-action="Landing">
                <span class="admin-brand-mark">U</span>
                <span><strong>UnityFunds</strong><small>ADMIN CONSOLE</small></span>
            </a>
            <div class="admin-nav-scroll">
                <div class="admin-nav-label">OVERVIEW</div>
                <a class="admin-nav-link @Active("Landing")" asp-controller="Admin" asp-action="Landing"><span class="nav-icon">▦</span>Dashboard</a>

                <div class="admin-nav-label">CONTENT MANAGEMENT</div>
                <a class="admin-nav-link @Active("ManageAllPosts")" asp-controller="Admin" asp-action="ManageAllPosts"><span class="nav-icon">▤</span>Manage Posts</a>
                <a class="admin-nav-link @Active("CampaignReview")" asp-controller="Admin" asp-action="CampaignReview"><span class="nav-icon">◇</span>Campaign Review</a>
                <a class="admin-nav-link @Active("PublicHelp")" asp-controller="Admin" asp-action="PublicHelp"><span class="nav-icon">✉</span>Public Questions</a>

                <div class="admin-nav-label">ORGANIZATIONS</div>
                <a class="admin-nav-link @Active("NgoManage")" asp-controller="Admin" asp-action="NgoManage"><span class="nav-icon">▥</span>Manage NGOs</a>
                <a class="admin-nav-link @Active("NgoAccountRequests")" asp-controller="Admin" asp-action="NgoAccountRequests"><span class="nav-icon">✓</span>NGO Approval</a>
                <a class="admin-nav-link @Active("LogisticsAccountRequests")" asp-controller="Admin" asp-action="LogisticsAccountRequests"><span class="nav-icon">⇢</span>Logistics Approval</a>

                <div class="admin-nav-label">PEOPLE & ACCESS</div>
                <a class="admin-nav-link @Active("UserManagement")" asp-controller="Admin" asp-action="UserManagement"><span class="nav-icon">♙</span>User Management</a>
                <a class="admin-nav-link @Active("GovnManage")" asp-controller="Admin" asp-action="GovnManage"><span class="nav-icon">⌂</span>Government Staff</a>

                <div class="admin-nav-label">INSIGHTS</div>
                <a class="admin-nav-link @Active("Analytics")" asp-controller="Admin" asp-action="Analytics"><span class="nav-icon">▥</span>Analytics</a>
            </div>
            <div class="admin-sidebar-footer">
                <a class="admin-nav-link" href="/"><span class="nav-icon">↗</span>View Website</a>
                <a class="admin-nav-link admin-logout" asp-controller="Admin" asp-action="Logout"><span class="nav-icon">⇥</span>Logout</a>
            </div>
        </aside>

        <div class="admin-main-column">
            <header class="admin-topbar">
                <button class="admin-menu-toggle" type="button" aria-label="Toggle navigation" onclick="document.body.classList.toggle('admin-nav-open')">☰</button>
                <div class="admin-topbar-title">
                    <span class="admin-topbar-kicker">UNITYFUNDS / ADMIN</span>
                    <strong>@ViewData["Title"]</strong>
                </div>
                <div class="admin-topbar-user">
                    <span class="admin-avatar">@((adminName.Length > 0 ? adminName.Substring(0,1) : "A").ToUpper())</span>
                    <span><strong>@adminName</strong><small>Administrator</small></span>
                </div>
            </header>
            <main class="admin-content">
                @RenderBody()
            </main>
            <footer class="admin-footer">© @DateTime.Now.Year UnityFunds · Platform administration</footer>
        </div>
    </div>
    <div class="admin-mobile-backdrop" onclick="document.body.classList.remove('admin-nav-open')"></div>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
      document.querySelectorAll('.admin-content table').forEach(function(table) {
        if (!table.parentElement.classList.contains('admin-table-wrap')) {
          const wrap = document.createElement('div');
          wrap.className = 'admin-table-wrap';
          table.parentNode.insertBefore(wrap, table);
          wrap.appendChild(table);
        }
      });
    </script>
</body>
</html>
