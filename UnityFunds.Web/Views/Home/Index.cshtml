@{
    ViewData["Title"] = "Home";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="UnityFunds connects donors, NGOs and community partners to turn generosity into measurable impact." />
    <meta name="theme-color" content="#10251f" />
    <title>UnityFunds — Small acts. Shared impact.</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/unityfunds-refresh.css" />
</head>
<body class="home-page">
    <header class="site-header">
        <a class="brand" asp-controller="Home" asp-action="Index" aria-label="UnityFunds home">
            <span class="brand-mark">U</span>
            <span><strong>unityfunds</strong><small>GOOD THINGS GROW TOGETHER</small></span>
        </a>
        <button class="mobile-menu-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false" aria-controls="main-navigation">
            <span></span><span></span><span></span>
        </button>
        <nav class="main-navigation" id="main-navigation" aria-label="Main navigation">
            <a class="nav-link active" asp-controller="Home" asp-action="Index">Home</a>
            <a class="nav-link" href="#how-it-works">How it works</a>
            <a class="nav-link" href="#community">Our community</a>
            <div class="nav-dropdown">
                <button class="nav-link dropdown-trigger" type="button" aria-expanded="false">Sign in <span aria-hidden="true">⌄</span></button>
                <div class="dropdown-panel">
                    <a asp-controller="Donor" asp-action="Login">Donor</a>
                    <a asp-controller="Ngo" asp-action="Login">NGO partner</a>
                    <a asp-controller="Logistics" asp-action="Login">Logistics partner</a>
                    <a asp-controller="Admin" asp-action="Login">Administrator</a>
                </div>
            </div>
            <a class="button button-dark button-small" asp-controller="Donor" asp-action="Signup">Join the community <span aria-hidden="true">↗</span></a>
        </nav>
    </header>

    <main>
        <section class="hero-section">
            <div class="hero-copy">
                <div class="eyebrow"><span class="eyebrow-dot"></span> A COMMUNITY THAT CARES</div>
                <h1>Make kindness<br />go <span>further.</span></h1>
                <p class="hero-description">Every contribution can change a story. Connect with people creating real change and help turn good intentions into meaningful action.</p>
                <div class="hero-actions">
                    <a class="button button-primary" asp-controller="Donor" asp-action="Signup">Start making an impact <span aria-hidden="true">→</span></a>
                    <a class="text-link" href="#how-it-works">Discover how it works <span aria-hidden="true">↓</span></a>
                </div>
                <div class="hero-note"><div class="avatar-stack"><span>♥</span><span>✦</span><span>●</span></div><span><strong>One community.</strong> Many ways to make a difference.</span></div>
            </div>
            <div class="hero-visual">
                <div class="hero-image-wrap"><img src="~/images/donation-cover.jpg" alt="Community members coming together to support a cause" /></div>
                <div class="floating-note"><span class="note-icon">✳</span><span><strong>Give with purpose</strong><small>Support a cause that matters</small></span></div>
                <div class="hero-sticker">BETTER<br />TOGETHER</div>
            </div>
            <div class="hero-bottom-label"><span>01 / 03</span><span class="label-line"></span><span>CHANGE STARTS HERE</span></div>
        </section>

        <section class="impact-strip" id="community">
            <div><span class="impact-symbol">✳</span><p><strong>People-powered</strong><small>Built around community</small></p></div>
            <div><span class="impact-symbol">♡</span><p><strong>Purpose-led</strong><small>Every act has meaning</small></p></div>
            <div><span class="impact-symbol">↗</span><p><strong>Transparent giving</strong><small>Keep impact in focus</small></p></div>
        </section>

        <section class="intro-section" id="how-it-works">
            <div class="section-kicker">THE UNITYFUNDS WAY <span>✳</span></div>
            <div class="intro-grid">
                <h2>Good change<br />is a <em>team effort.</em></h2>
                <div class="intro-copy"><p>UnityFunds brings donors, non-profit organisations and logistics partners into one connected community. Find a cause, offer support and help resources reach the people who need them.</p><a class="text-link dark-link" asp-controller="Ngo" asp-action="Signup">Become a community partner <span>→</span></a></div>
            </div>
            <div class="feature-grid">
                <article class="feature-card feature-card-highlight"><div class="feature-number">01</div><div class="feature-icon">♡</div><h3>Give your way</h3><p>Support causes through contributions that fit your interests and your ability to help.</p><a asp-controller="Donor" asp-action="Signup" aria-label="Join as a donor">↗</a></article>
                <article class="feature-card"><div class="feature-number">02</div><div class="feature-icon">✳</div><h3>Make good happen</h3><p>NGOs can share their work, connect with supporters and bring community needs into view.</p><a asp-controller="Ngo" asp-action="Signup" aria-label="Register as an NGO">↗</a></article>
                <article class="feature-card"><div class="feature-number">03</div><div class="feature-icon">⌁</div><h3>Deliver with care</h3><p>Logistics partners help coordinate physical donations and support the last mile of giving.</p><a asp-controller="Logistics" asp-action="Signup" aria-label="Register as a logistics partner">↗</a></article>
            </div>
        </section>

        <section class="closing-section">
            <div><div class="section-kicker light-kicker">YOUR NEXT STEP STARTS HERE</div><h2>There is more than<br />one way to <em>help.</em></h2><p>Bring what you can. Share what you know. Be part of something bigger.</p></div>
            <a class="button button-light" asp-controller="Donor" asp-action="Signup">Join UnityFunds <span>↗</span></a>
            <span class="closing-decoration">✳</span>
        </section>
        @* <section class="container py-4 text-center"><h2>Make a difference today</h2><p>Discover community fundraising campaigns and support verified causes.</p><a class="button button-primary" href="/Campaigns">Explore campaigns</a></section> *@
        <div class="intro-grid">
                <h2>Make a difference today</h2>
                <div class="intro-copy"><p>Discover community fundraising campaigns and support verified causes.</p><a class="button button-primary" href="/Campaigns">Explore campaigns</a></div>
        </div>
    </main>

    <footer class="site-footer"><a class="brand footer-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">U</span><span><strong>unityfunds</strong><small>GOOD THINGS GROW TOGETHER</small></span></a><p>Small acts. Shared impact.</p><span>© @DateTime.Now.Year UnityFunds. All rights reserved.</span></footer>
    <script>
        (() => {
            const menu = document.querySelector('.mobile-menu-toggle');
            const nav = document.querySelector('.main-navigation');
            menu?.addEventListener('click', () => {
                const expanded = menu.getAttribute('aria-expanded') === 'true';
                menu.setAttribute('aria-expanded', String(!expanded));
                nav?.classList.toggle('is-open', !expanded);
            });
            document.querySelectorAll('.dropdown-trigger').forEach(button => button.addEventListener('click', () => {
                const expanded = button.getAttribute('aria-expanded') === 'true';
                button.setAttribute('aria-expanded', String(!expanded));
                button.nextElementSibling?.classList.toggle('is-open', !expanded);
            }));
        })();
    </script>
</body>
</html>


