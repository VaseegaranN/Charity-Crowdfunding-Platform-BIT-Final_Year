
@model UnityFunds.Web.Models.ViewModels.CampaignCreateViewModel

@{
    ViewData["Title"] = "Create campaign";
}

<div class="container py-5" style="max-width:760px">
    <h1>Create a campaign</h1>

    <p class="text-muted">
        Your campaign will be reviewed by an administrator before it becomes public.
    </p>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control mb-3" />
        <span asp-validation-for="Title" class="text-danger"></span>

        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" rows="6"
                  class="form-control mb-3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>

        <label asp-for="Category" class="form-label"></label>
        <select asp-for="Category" class="form-select mb-3">
            <option>Education</option>
            <option>Health</option>
            <option>Community</option>
            <option>Environment</option>
            <option>Emergency</option>
            <option>General</option>
        </select>
        <span asp-validation-for="Category" class="text-danger"></span>

        <label asp-for="GoalAmount" class="form-label">
            Fundraising goal (INR)
        </label>
        <input asp-for="GoalAmount" type="number" min="1"
               step="0.01" class="form-control mb-3" />
        <span asp-validation-for="GoalAmount" class="text-danger"></span>

        <label asp-for="ImageUrl" class="form-label">
            Image URL (optional)
        </label>
        <input asp-for="ImageUrl" class="form-control mb-3" />
        <span asp-validation-for="ImageUrl" class="text-danger"></span>

        <button type="submit" class="btn btn-success">
            Submit for review
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}