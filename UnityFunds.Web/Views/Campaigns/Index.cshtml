@model IReadOnlyList<UnityFunds.Web.Models.Campaign>
@{ ViewData["Title"]="Explore campaigns"; }
<section class="container py-5"><div class="d-flex justify-content-between align-items-center flex-wrap gap-3"><div><p class="text-uppercase text-success fw-bold">Make an impact</p><h1>Explore campaigns</h1><p class="text-muted">Support verified causes and help communities move forward.</p></div><a class="btn btn-success" asp-controller="Ngo" asp-action="Login">NGO sign in to create</a></div>
<form method="get" class="row g-2 my-4"><div class="col-md-8"><input class="form-control" name="q" value="@ViewBag.Query" placeholder="Search campaigns" /></div><div class="col-md-3"><select class="form-select" name="category"><option value="">All categories</option>@foreach(var c in new[]{"Education","Health","Community","Environment","Emergency","General"}){<option selected="@(ViewBag.Category==c)" value="@c">@c</option>}</select></div><div class="col-md-1"><button class="btn btn-dark w-100">Go</button></div></form>
<div class="row g-4">@foreach(var c in Model){<div class="col-md-6 col-lg-4"><article class="card h-100 shadow-sm border-0">@if(!string.IsNullOrWhiteSpace(c.ImageUrl)){<img src="@c.ImageUrl" class="card-img-top" style="height:190px;object-fit:cover" alt="Campaign image"/>}<div class="card-body"><span class="badge text-bg-success">@c.Category</span><h2 class="h5 mt-3">@c.Title</h2><p class="text-muted">@c.Description</p><div class="progress my-3" role="progressbar" aria-label="Fundraising progress"><div class="progress-bar bg-success" style="width:@(c.GoalAmount>0?Math.Min(100,(double)(c.RaisedAmount/c.GoalAmount*100)):0)%"></div></div><div class="d-flex justify-content-between small"><strong>₹@c.RaisedAmount.ToString("N0") raised</strong><span>Goal ₹@c.GoalAmount.ToString("N0")</span></div><a asp-action="Details" asp-route-id="@c.Id" class="btn btn-outline-success mt-3 w-100">View campaign</a></div></article></div>}</div>
@if(Model.Count==0){<div class="alert alert-light border mt-4">No approved campaigns found. Please check back soon.</div>}</section>
