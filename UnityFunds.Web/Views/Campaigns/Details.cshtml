@model UnityFunds.Web.Models.Campaign
@{ ViewData["Title"]=Model.Title; }
<section class="container py-5"><a asp-action="Index" class="text-success">← All campaigns</a><div class="row g-5 mt-2"><div class="col-lg-7"><span class="badge text-bg-success">@Model.Category</span><h1 class="mt-3">@Model.Title</h1><p class="text-muted">Organized by @Model.NgoName</p><p class="lead">@Model.Description</p></div><div class="col-lg-5"><div class="card border-0 shadow-sm"><div class="card-body p-4"><h2 class="h3">₹@Model.RaisedAmount.ToString("N0")</h2><p class="text-muted">raised of ₹@Model.GoalAmount.ToString("N0")</p><div class="progress mb-4"><div class="progress-bar bg-success" style="width:@(Model.GoalAmount>0?Math.Min(100,(double)(Model.RaisedAmount/Model.GoalAmount*100)):0)%"></div></div>@if(TempData["DonationInfo"]!=null){<div class="alert alert-info">@TempData["DonationInfo"]</div>}@if(TempData["DonationError"]!=null){<div class="alert alert-danger">@TempData["DonationError"]</div>}<form asp-action="Donate" method="post"><input type="hidden" name="campaignId" value="@Model.Id"/><label class="form-label" for="amount">Donation amount (INR)</label><input id="amount" name="amount" type="number" min="1" max="1000000" step="0.01" required class="form-control mb-3" placeholder="Enter amount"/><button class="btn btn-success w-100">Continue to donation</button></form><small class="text-muted d-block mt-3">Payments are not enabled until a payment provider is configured. This form records a pending donation only.</small></div></div></div></div></section>
