@model List<UnityFunds.Web.Models.LogisticsDetails>
@{ ViewData["Title"] = "Logistics Account Requests"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }

<div class="container">
        <h1>Logistics Account Requests</h1>
        @if(Model.Count == 0) { <p style="text-align:center;">No pending requests.</p> }
        else {
        <table>
            <tr><th>ID</th><th>Name</th><th>Email</th><th>Phone</th><th>Org Name</th><th>Status</th><th>Actions</th></tr>
            @foreach(var log in Model)
            {
                <tr>
                    <td>@log.logistics_id</td><td>@log.logistics_user_name</td><td>@log.logistics_user_email</td><td>@log.logistics_user_phone</td><td>@log.logistics_org_name</td><td>@log.logistics_account_req_status</td>
                    <td>
                        <form method="post" asp-action="ApproveLogistics" style="display:inline;">
                            <input type="hidden" name="id" value="@log.logistics_id" />
                            <input type="hidden" name="status" value="Approved" />
                            <button type="submit" class="btn btn-approve">Approve</button>
                        </form>
                        <form method="post" asp-action="ApproveLogistics" style="display:inline;">
                            <input type="hidden" name="id" value="@log.logistics_id" />
                            <input type="hidden" name="status" value="Rejected" />
                            <button type="submit" class="btn btn-reject">Reject</button>
                        </form>
                    </td>
                </tr>
            }
        </table>
        }
    </div>
