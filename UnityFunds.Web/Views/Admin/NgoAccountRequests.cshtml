@model List<UnityFunds.Web.Models.NgoDetails>
@{ ViewData["Title"] = "NGO Account Requests"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }

<div class="container">
        <h1>NGO Account Requests</h1>
        @if(Model.Count == 0) { <p style="text-align:center;">No pending requests.</p> }
        else {
        <table>
            <tr><th>NGO ID</th><th>Name</th><th>Email</th><th>Phone</th><th>Org Name</th><th>Status</th><th>Actions</th></tr>
            @foreach(var ngo in Model)
            {
                <tr>
                    <td>@ngo.ngo_id</td><td>@ngo.ngo_user_name</td><td>@ngo.ngo_user_email</td><td>@ngo.ngo_user_phone</td><td>@ngo.ngo_org_name</td><td>@ngo.ngo_acc_req_status</td>
                    <td>
                        <form method="post" asp-action="ApproveNgo" style="display:inline;">
                            <input type="hidden" name="id" value="@ngo.ngo_id" />
                            <input type="hidden" name="status" value="Approved" />
                            <button type="submit" class="btn btn-approve">Approve</button>
                        </form>
                        <form method="post" asp-action="ApproveNgo" style="display:inline;">
                            <input type="hidden" name="id" value="@ngo.ngo_id" />
                            <input type="hidden" name="status" value="Rejected" />
                            <button type="submit" class="btn btn-reject">Reject</button>
                        </form>
                    </td>
                </tr>
            }
        </table>
        }
    </div>
