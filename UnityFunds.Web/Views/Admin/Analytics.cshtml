@{ ViewData["Title"]="Analytics"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
<div class="container py-5"><h1>Platform analytics</h1><p class="text-muted">Operational overview based on recorded platform data.</p><div class="row g-3 my-3"><div class="col-md-4"><div class="card p-4"><div class="text-muted">Successful donations</div><div class="display-6">₹@(((decimal)ViewBag.TotalDonations).ToString("N2"))</div></div></div><div class="col-md-4"><div class="card p-4"><div class="text-muted">Completed donation count</div><div class="display-6">@ViewBag.DonationCount</div></div></div><div class="col-md-4"><div class="card p-4"><div class="text-muted">Pending payment intents</div><div class="display-6">@ViewBag.PendingPayments</div></div></div><div class="col-md-6"><div class="card p-4"><div class="text-muted">Approved campaigns</div><div class="display-6">@ViewBag.ActiveCampaigns</div></div></div><div class="col-md-6"><div class="card p-4"><div class="text-muted">Campaigns awaiting review</div><div class="display-6">@ViewBag.PendingCampaigns</div></div></div></div><h2 class="h4 mt-4">Recent donation activity</h2><div class="table-responsive"><table class="table"><thead><tr><th>Reference</th><th>Campaign</th><th>Donor</th><th>Amount</th><th>Status</th><th>Date</th></tr></thead><tbody>@foreach(var d in (IEnumerable<UnityFunds.Web.Models.Donation>)ViewBag.RecentDonations){<tr><td>@d.PaymentReference</td><td>@d.CampaignId</td><td>@d.DonorId</td><td>₹@d.Amount.ToString("N2")</td><td>@d.Status</td><td>@d.CreatedAtUtc.ToString("u")</td></tr>}</tbody></table></div></div>
