@{
    ViewData["Title"] = "Donor Dashboard";
    Layout = null;
    var donor = ViewBag.Donor as UnityFunds.Web.Models.DonorDetails;
    var posts = ViewBag.Posts as List<UnityFunds.Web.Models.PublicPost> ?? new List<UnityFunds.Web.Models.PublicPost>();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Donor Dashboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="/css/portal-dashboard.css" asp-append-version="true"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <link rel="stylesheet" href="/css/unityfunds-refresh.css" />
</head>
<body class="uf-portal uf-portal-donor">
    <div id="nav-bar">
        <div id="nav-header"><a id="nav-title" href="/Donor/Landing">UnityFunds</a><hr style="border-color:#333;margin-top:15px;"></div>
        <div id="nav-content">
            <button class="nav-button active" data-tab="profile"><i class="fas fa-user"></i><span>Profile</span></button>
            <button class="nav-button" data-tab="create"><i class="fas fa-plus"></i><span>Create Post</span></button>
            <button class="nav-button" data-tab="funds"><i class="fas fa-hand-holding-heart"></i><span>Request Funds</span></button>
            <button class="nav-button" data-tab="activity"><i class="fas fa-receipt"></i><span>Your Activity</span></button>
            <button class="nav-button" data-tab="faq"><i class="fas fa-question"></i><span>FAQ - HELP</span></button>
        </div>
        <div style="position:absolute;bottom:20px;left:20px;">
            <div class="nav-button"><a href="/Donor/Logout" style="color:#aaa;text-decoration:none;"><i class="fas fa-sign-out-alt"></i><span> Logout</span></a></div>
        </div>
    </div>
    <div class="portal-mobile-backdrop" onclick="document.body.classList.remove('portal-nav-open')"></div>
    <div class="main-content">
        <div class="portal-topbar">
        <div class="portal-topbar-left">
            <button class="portal-menu-toggle" type="button" aria-label="Toggle navigation" onclick="document.body.classList.toggle('portal-nav-open')">☰</button>
            <div><span class="portal-kicker">UNITYFUNDS / DONOR</span><strong class="portal-page-title">Donor Workspace</strong></div>
        </div>
        <div class="portal-user"><span class="portal-avatar">D</span><span>@(donor?.donor_user_name ?? "Donor")</span></div>
    </div>
        <h1>Welcome, @(donor?.donor_user_name ?? "Donor")!</h1>

        <div class="stat-row">
            <div class="stat"><div class="n">@posts.Count</div><div class="t">Your Posts</div></div>
            <div class="stat"><div class="n">@(string.IsNullOrWhiteSpace(donor?.donationAmount) ? "-" : donor.donationAmount)</div><div class="t">Donation Amount</div></div>
            <div class="stat"><div class="n">@(string.IsNullOrWhiteSpace(donor?.fundingType) ? "-" : donor.fundingType)</div><div class="t">Funding Type</div></div>
            <div class="stat"><div class="n">@(string.IsNullOrWhiteSpace(donor?.paymentType) ? "-" : donor.paymentType)</div><div class="t">Payment Type</div></div>
        </div>

        <section id="tab-profile" class="tab-section active">
            <div class="card">
                <h2>My Profile</h2>
                <div class="info-grid">
                    <div class="info-item"><div class="label">Full Name</div><div class="value">@donor?.donor_user_name</div></div>
                    <div class="info-item"><div class="label">Email</div><div class="value">@donor?.donor_user_email</div></div>
                    <div class="info-item"><div class="label">Phone</div><div class="value">@donor?.donor_user_phone</div></div>
                    <div class="info-item"><div class="label">Gender</div><div class="value">@donor?.donor_user_gender</div></div>
                    <div class="info-item"><div class="label">Street</div><div class="value">@donor?.donor_user_street</div></div>
                    <div class="info-item"><div class="label">City</div><div class="value">@donor?.donor_user_city</div></div>
                    <div class="info-item"><div class="label">State</div><div class="value">@donor?.donor_user_state</div></div>
                    <div class="info-item"><div class="label">Zip Code</div><div class="value">@donor?.donor_user_zip</div></div>
                    <div class="info-item"><div class="label">Country</div><div class="value">@donor?.donor_user_country</div></div>
                    <div class="info-item"><div class="label">Payment Type</div><div class="value">@donor?.paymentType</div></div>
                    <div class="info-item"><div class="label">Funding Type</div><div class="value">@donor?.fundingType</div></div>
                </div>
            </div>
        </section>

        <section id="tab-create" class="tab-section">
            <div class="card">
                <h2>Create a Post</h2>
                <p class="muted">Share an update with the UnityFunds community.</p>
                <form method="post" asp-controller="Donor" asp-action="CreatePost">
                    <label>Post Type</label>
                    <select name="postType">
                        <option value="General">General</option>
                        <option value="Update">Update</option>
                        <option value="Fund Request">Fund Request</option>
                    </select>
                    <label>Message</label>
                    <textarea name="content" placeholder="What would you like to share?" required></textarea>
                    <button type="submit" class="btn">Publish Post</button>
                </form>
            </div>
        </section>

        <section id="tab-funds" class="tab-section">
            <div class="card">
                <h2>Request Funds</h2>
                <p class="muted">Describe the cause you are raising funds for. Your request will appear in your activity feed.</p>
                <form method="post" asp-controller="Donor" asp-action="CreatePost">
                    <input type="hidden" name="postType" value="Fund Request" />
                    <label>Fundraising Details</label>
                    <textarea name="content" placeholder="Tell us what you are raising funds for, the target amount and why it matters." required></textarea>
                    <button type="submit" class="btn">Submit Fund Request</button>
                </form>
            </div>
        </section>

        <section id="tab-activity" class="tab-section">
            <div class="card">
                <h2>Your Activity</h2>
                <p class="muted">Recent posts and requests created from your account.</p>
                @if (posts.Count == 0)
                {
                    <p class="muted">You have not created any posts yet. Use <strong>Create Post</strong> to get started.</p>
                }
                else
                {
                    foreach (var p in posts)
                    {
                        <div class="post">
                            <div class="meta">
                                @p.pp_date &middot; @p.pp_userloc
                                <span class="tag">@p.pp_type</span>
                            </div>
                            <div class="body">@p.pp_userpost_description</div>
                        </div>
                    }
                }
            </div>
            <div class="card">
                <h2>Donation Details</h2>
                <div class="info-grid">
                    <div class="info-item"><div class="label">Donation Amount</div><div class="value">@(string.IsNullOrWhiteSpace(donor?.donationAmount) ? "-" : donor.donationAmount)</div></div>
                    <div class="info-item"><div class="label">Funding Type</div><div class="value">@(string.IsNullOrWhiteSpace(donor?.fundingType) ? "-" : donor.fundingType)</div></div>
                    <div class="info-item"><div class="label">Payment Type</div><div class="value">@(string.IsNullOrWhiteSpace(donor?.paymentType) ? "-" : donor.paymentType)</div></div>
                </div>
            </div>
        </section>

        <section id="tab-faq" class="tab-section">
            <div class="card">
                <h2>FAQ &amp; Help</h2>
                <div class="faq-item">
                    <h3>How do I donate?</h3>
                    <p>Browse campaigns on the home page and choose the cause you want to support with your preferred payment type.</p>
                </div>
                <div class="faq-item">
                    <h3>What is the difference between fixed and flexible funding?</h3>
                    <p>Fixed funding is released only when the target is reached; flexible funding lets the cause receive whatever is raised.</p>
                </div>
                <div class="faq-item">
                    <h3>How do I create a post?</h3>
                    <p>Use the <strong>Create Post</strong> menu item, choose a type, write your message and click Publish Post.</p>
                </div>
                <div class="faq-item">
                    <h3>How do I request funds?</h3>
                    <p>Open <strong>Request Funds</strong>, describe your cause and target amount, then submit. It will appear in Your Activity.</p>
                </div>
                <div class="faq-item">
                    <h3>Need more help?</h3>
                    <p>Contact the UnityFunds support team through the home page or reach out to an administrator.</p>
                </div>
            </div>
        </section>
        <div class="portal-footer">© 2026 UnityFunds · Donor workspace</div>
    </div>

    <script>
        (function () {
            var buttons = document.querySelectorAll('.nav-button[data-tab]');
            var sections = document.querySelectorAll('.tab-section');

            function show(tab) {
                buttons.forEach(function (b) { b.classList.toggle('active', b.dataset.tab === tab); });
                sections.forEach(function (s) { s.classList.toggle('active', s.id === 'tab-' + tab); });
            }

            buttons.forEach(function (b) {
                b.addEventListener('click', function () {
                    show(b.dataset.tab);
                    if (history.replaceState) history.replaceState(null, '', '#' + b.dataset.tab);
                });
            });

            var hash = (location.hash || '').replace('#', '');
            if (hash && document.getElementById('tab-' + hash)) show(hash);
        })();
    </script>
</body>
</html>
