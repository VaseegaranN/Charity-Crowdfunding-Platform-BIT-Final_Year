
# Stage 1: Build the ASP.NET Core application
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

WORKDIR /src

COPY ["UnityFunds.Web/UnityFunds.Web.csproj", "UnityFunds.Web/"]

RUN dotnet restore "UnityFunds.Web/UnityFunds.Web.csproj"

COPY . .

WORKDIR /src/UnityFunds.Web

RUN dotnet publish "UnityFunds.Web.csproj" \
    -c Release \
    -o /app/publish \
    /p:UseAppHost=false

# Stage 2: Run the published application
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final

WORKDIR /app

COPY --from=build /app/publish .

ENV ASPNETCORE_ENVIRONMENT=Production

EXPOSE 80

# Vercel supplies PORT; default to 80 if it is absent
CMD ["sh", "-c", "dotnet UnityFunds.Web.dll --urls http://0.0.0.0:${PORT:-80}"]
